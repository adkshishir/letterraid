# Production build-time values. Next.js loads this automatically for
# `next build` / `next start`, so a plain `npm run build` on the box now bakes
# the real domains into the client bundle.
#
# These MUST live in a file, not just pm2's `env`: NEXT_PUBLIC_* is inlined at
# BUILD time, and pm2 only sets variables for the running server process. A
# build without them silently falls back to localhost, and the deployed site
# then dials the visitor's own machine — the socket never connects and the app
# hangs on "Creating…".
#
# Nothing secret belongs here: every NEXT_PUBLIC_* value ships to the browser.
# Changing a domain requires a rebuild, not just a pm2 restart.

NEXT_PUBLIC_SITE_URL=https://letterraid.adhikarishishir.com.np
NEXT_PUBLIC_BACKEND_URL=https://api.letterraid.adhikarishishir.com.np
